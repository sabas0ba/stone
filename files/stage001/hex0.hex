# stage001/hex0.bin のソース表現 (hex0 言語，docs/stage001-hex0.md 2 章)。
# 本ファイルはビルドには使用しない検証入力である (同 5 章)。
# hex0(本ファイル) の出力が hex0.bin とビット一致することをテストで検証する。

# 初期化
b7 02 00 10   # 80000000: lui  x5, 0x10000       ; x5 = UART base 0x1000_0000
37 03 10 00   # 80000004: lui  x6, 0x100         ; x6 = test finisher 0x0010_0000
93 04 00 00   # 80000008: addi x9, x0, 0         ; 桁状態 = 上位桁待ち

# main_loop: 1 文字受信 (LSR.DR ポーリング)
03 c5 52 00   # 8000000c: lbu  x10, 5(x5)        ; LSR 読出し
13 75 15 00   # 80000010: andi x10, x10, 1       ; DR (bit0)
e3 0c 05 fe   # 80000014: beq  x10, x0, 8000000c ; 受信待ち
83 c3 02 00   # 80000018: lbu  x7, 0(x5)         ; RBR -> x7 = 受信文字

# 16 進数字の判定 ('0'..'9' / 'a'..'f')
13 05 00 03   # 8000001c: addi x10, x0, 0x30     ; '0'
63 cc a3 04   # 80000020: blt  x7, x10, 80000078 ; c < '0' -> not_hex
13 05 a0 03   # 80000024: addi x10, x0, 0x3a     ; '9'+1
63 cc a3 00   # 80000028: blt  x7, x10, 80000040 ; c <= '9' -> dig09
13 05 10 06   # 8000002c: addi x10, x0, 0x61     ; 'a'
63 c4 a3 04   # 80000030: blt  x7, x10, 80000078 ; c < 'a' -> not_hex
13 05 70 06   # 80000034: addi x10, x0, 0x67     ; 'f'+1
63 c8 a3 00   # 80000038: blt  x7, x10, 80000048 ; c <= 'f' -> digaf
6f 00 c0 03   # 8000003c: jal  x0, 80000078      ; not_hex

# dig09 / digaf: 文字から値へ
93 85 03 fd   # 80000040: addi x11, x7, -0x30    ; x11 = c - '0'
6f 00 80 00   # 80000044: jal  x0, 8000004c      ; have_digit
93 85 93 fa   # 80000048: addi x11, x7, -0x57    ; x11 = c - 'a' + 10

# have_digit: 桁状態で分岐
63 98 04 00   # 8000004c: bne  x9, x0, 8000005c  ; 下位桁待ち -> low_digit
13 94 45 00   # 80000050: slli x8, x11, 4        ; 上位桁を x8 に格納
93 04 10 00   # 80000054: addi x9, x0, 1         ; 桁状態 = 下位桁待ち
6f f0 5f fb   # 80000058: jal  x0, 8000000c      ; main_loop

# low_digit: バイト完成，送信 (LSR.THRE ポーリング)
33 64 b4 00   # 8000005c: or   x8, x8, x11       ; x8 = 完成したバイト
03 c5 52 00   # 80000060: lbu  x10, 5(x5)        ; LSR 読出し
13 75 05 02   # 80000064: andi x10, x10, 0x20    ; THRE (bit5)
e3 0c 05 fe   # 80000068: beq  x10, x0, 80000060 ; 送信可待ち
23 80 82 00   # 8000006c: sb   x8, 0(x5)         ; THR へ出力
93 04 00 00   # 80000070: addi x9, x0, 0         ; 桁状態 = 上位桁待ち
6f f0 9f f9   # 80000074: jal  x0, 8000000c      ; main_loop

# not_hex: 16 進数字以外の処理
63 9c 04 02   # 80000078: bne  x9, x0, 800000b0  ; 下位桁待ち -> nh_low
13 05 30 02   # 8000007c: addi x10, x0, 0x23     ; '#'
63 8e a3 02   # 80000080: beq  x7, x10, 800000bc ; -> comment
13 05 00 02   # 80000084: addi x10, x0, 0x20     ; SP
e3 82 a3 f8   # 80000088: beq  x7, x10, 8000000c ; main_loop
13 05 90 00   # 8000008c: addi x10, x0, 0x09     ; TAB
e3 8e a3 f6   # 80000090: beq  x7, x10, 8000000c ; main_loop
13 05 d0 00   # 80000094: addi x10, x0, 0x0d     ; CR
e3 8a a3 f6   # 80000098: beq  x7, x10, 8000000c ; main_loop
13 05 a0 00   # 8000009c: addi x10, x0, 0x0a     ; LF
e3 86 a3 f6   # 800000a0: beq  x7, x10, 8000000c ; main_loop
13 05 e0 02   # 800000a4: addi x10, x0, 0x2e     ; '.'
63 88 a3 02   # 800000a8: beq  x7, x10, 800000d8 ; -> pass
6f 00 80 03   # 800000ac: jal  x0, 800000e4      ; err1 (許可されない文字)

# nh_low: 桁間への他文字の混入
13 05 e0 02   # 800000b0: addi x10, x0, 0x2e     ; '.'
63 8e a3 02   # 800000b4: beq  x7, x10, 800000f0 ; -> err2 (奇数桁で終端)
6f 00 c0 02   # 800000b8: jal  x0, 800000e4      ; err1

# comment: LF まで読み飛ばす
03 c5 52 00   # 800000bc: lbu  x10, 5(x5)        ; LSR 読出し
13 75 15 00   # 800000c0: andi x10, x10, 1       ; DR (bit0)
e3 0c 05 fe   # 800000c4: beq  x10, x0, 800000bc ; 受信待ち
83 c3 02 00   # 800000c8: lbu  x7, 0(x5)         ; RBR -> x7
13 05 a0 00   # 800000cc: addi x10, x0, 0x0a     ; LF
e3 8e a3 f2   # 800000d0: beq  x7, x10, 8000000c ; main_loop
6f f0 9f fe   # 800000d4: jal  x0, 800000bc      ; comment

# pass / err1 / err2: 終了値を x12 へ設定し do_exit へ
37 56 00 00   # 800000d8: lui  x12, 0x5          ; pass:
13 06 56 55   # 800000dc: addi x12, x12, 0x555   ; x12 = 0x5555 (FINISHER_PASS)
6f 00 80 01   # 800000e0: jal  x0, 800000f8      ; do_exit
37 36 01 00   # 800000e4: lui  x12, 0x13         ; err1:
13 06 36 33   # 800000e8: addi x12, x12, 0x333   ; x12 = 0x13333 (code 1)
6f 00 c0 00   # 800000ec: jal  x0, 800000f8      ; do_exit
37 36 02 00   # 800000f0: lui  x12, 0x23         ; err2:
13 06 36 33   # 800000f4: addi x12, x12, 0x333   ; x12 = 0x23333 (code 2)

# do_exit: test finisher へ書込み (QEMU はここで終了する)
23 20 c3 00   # 800000f8: sw   x12, 0(x6)
6f 00 00 00   # 800000fc: jal  x0, 800000fc      ; 自己ループ (到達しない)

# 終端
.
