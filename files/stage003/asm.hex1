13 05 20 00               #: addi x10 x0 2
!scan_loop 63 80 a7 00    #: beq x15 x10 scan_loop
$sym_lookup ef 00 00 00   #: jal x1 sym_lookup
!err4 63 90 08 00         #: bne x17 x0 err4
03 25 09 00               #: lw x10 0(x18)
23 20 a8 00               #: sw x10 0(x16)
03 25 49 00               #: lw x10 4(x18)
23 22 a8 00               #: sw x10 4(x16)
03 25 89 00               #: lw x10 8(x18)
