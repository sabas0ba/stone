93 85 85 01               #: addi x11 x11 24
$mn_loop 6f 00 00 00      #: jal x0 mn_loop
# '.' 終端: pass1 -> pass2 切替え / pass2 -> 正常終了
:s_end                    #: s_end:
13 05 20 00               #: addi x10 x0 2
!exit_ok 63 80 a7 00      #: beq x15 x10 exit_ok
93 07 20 00               #: addi x15 x0 2
$scan_init 6f 00 00 00    #: jal x0 scan_init

# ---- skipws: 空白 (SP TAB CR LF ',') とコメントの読み飛ばし。x7 = 次の有意文字 (消費済み) ----
:skipws                   #: skipws:
