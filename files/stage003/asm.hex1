# stage003/asm のソース (hex1 言語，docs/stage003-asm.md)。
# hex1 でビルドする: sh tools/build.sh stage003
#
# `#:` で始まるコメントは asm 言語への転記である。全コード行・データ行に付し，
# 機械抽出したものを asm 自身で処理して自己アセンブル固定点を検証する
# (tests/stage003/test.sh)。プレーンな `#` コメントは転記対象外の注記である。
#
# レジスタ割当は docs/stage003-asm.md 3.6 節を参照。

# ---- init: 定数レジスタの設定とニーモニック表アドレスの取得 ----
:init                     #: init:
b7 02 00 10               #: lui x5 0x10000
37 03 10 00               #: lui x6 0x100
37 09 0f 80               #: lui x18 0x800f0
b7 09 10 80               #: lui x19 0x80100
33 88 09 00               #: add x16 x19 x0
37 0a 20 80               #: lui x20 0x80200
:getmt                    #: getmt:
17 0f 00 00               #: auipc x30 0
03 2f cf 00               #: lw x30 12(x30)
$p0_start 6f 00 00 00     #: jal x0 p0_start
&mtable                   #: word mtable

# ---- pass0: UART から入力バッファへ (コメント内の '.' は終端としない) ----
:p0_start                 #: p0_start:
b3 06 0a 00               #: add x13 x20 x0
13 06 00 00               #: addi x12 x0 0
:p0_loop                  #: p0_loop:
03 c5 52 00               #: lbu x10 5(x5)
13 75 15 00               #: andi x10 x10 1
!p0_loop 63 00 05 00      #: beq x10 x0 p0_loop
83 c3 02 00               #: lbu x7 0(x5)
23 80 76 00               #: sb x7 0(x13)
93 86 16 00               #: addi x13 x13 1
!p0_incom 63 10 06 00     #: bne x12 x0 p0_incom
13 05 30 02               #: addi x10 x0 0x23
!p0_setcom 63 80 a3 00    #: beq x7 x10 p0_setcom
13 05 e0 02               #: addi x10 x0 0x2e
!p0_done 63 80 a3 00      #: beq x7 x10 p0_done
$p0_loop 6f 00 00 00      #: jal x0 p0_loop
:p0_incom                 #: p0_incom:
13 05 a0 00               #: addi x10 x0 0x0a
!p0_clrcom 63 80 a3 00    #: beq x7 x10 p0_clrcom
$p0_loop 6f 00 00 00      #: jal x0 p0_loop
:p0_clrcom                #: p0_clrcom:
13 06 00 00               #: addi x12 x0 0
$p0_loop 6f 00 00 00      #: jal x0 p0_loop
:p0_setcom                #: p0_setcom:
13 06 10 00               #: addi x12 x0 1
$p0_loop 6f 00 00 00      #: jal x0 p0_loop
:p0_done                  #: p0_done:
93 07 10 00               #: addi x15 x0 1

# ---- scanner: pass1/pass2 共用の走査本体 ----
