--- a/lib/riscv32.c
+++ b/lib/riscv32.c
@@ -0,0 +1,148 @@
+/* RV32 (ilp32) の実行時支援。
+ *
+ * 32 bit を対象にすると，tccgen.c の gen_opl が 64 bit の除算・剰余・
+ * 可変桁のシフトをここへ落としてくる。同じものが libtcc1.c にもあるが，
+ * あちらは `#if defined __i386__` の中にあり，i386 のインライン
+ * アセンブラ (sub_ddmmss) に依っているので使えない。素の C で書く。
+ *
+ * **ここでは 64 bit の / % と可変桁のシフトを使ってはいけない。**
+ * 使うと自分自身を呼ぶことになる。除算は 32 bit の桁ごとに組み立て，
+ * シフトは上下の語に分けて 32 bit のシフトで行う。桁数が定数の
+ * シフトと，加減算・比較は tcc がその場で展開するので使ってよい。 */
+
+typedef unsigned int u32;
+typedef unsigned long long u64;
+typedef long long i64;
+
+typedef union {
+    struct { u32 low, high; } s;   /* RV32 は little endian */
+    u64 ll;
+    i64 sll;
+} DW;
+
+/* 引き算しながら 1 桁ずつ商を立てる長除法。
+   a を左へ送り出しながら余り r に取り込む (桁数はすべて定数) */
+static u64 udivmod(u64 a, u64 b, u64 *rem)
+{
+    u64 q = 0, r = 0;
+    int i;
+
+    if (b == 0) {              /* 0 除算は値を決めておく */
+        if (rem)
+            *rem = 0;
+        return 0;
+    }
+    for (i = 0; i < 64; i++) {
+        r = (r << 1) | ((a >> 63) & 1);
+        a = a << 1;
+        q = q << 1;
+        if (r >= b) {
+            r = r - b;
+            q = q | 1;
+        }
+    }
+    if (rem)
+        *rem = r;
+    return q;
+}
+
+u64 __udivdi3(u64 a, u64 b)
+{
+    return udivmod(a, b, 0);
+}
+
+u64 __umoddi3(u64 a, u64 b)
+{
+    u64 r;
+    udivmod(a, b, &r);
+    return r;
+}
+
+i64 __divdi3(i64 a, i64 b)
+{
+    int neg = 0;
+    u64 q;
+
+    if (a < 0) { a = -a; neg = !neg; }
+    if (b < 0) { b = -b; neg = !neg; }
+    q = udivmod((u64)a, (u64)b, 0);
+    return neg ? -(i64)q : (i64)q;
+}
+
+i64 __moddi3(i64 a, i64 b)
+{
+    int neg = 0;
+    u64 r;
+
+    if (a < 0) { a = -a; neg = 1; }   /* 剰余の符号は被除数に合わせる */
+    if (b < 0) b = -b;
+    udivmod((u64)a, (u64)b, &r);
+    return neg ? -(i64)r : (i64)r;
+}
+
+i64 __ashldi3(i64 a, int b)
+{
+    DW u;
+    u.sll = a;
+    if (b >= 32) {
+        u.s.high = u.s.low << (b - 32);
+        u.s.low = 0;
+    } else if (b != 0) {
+        u.s.high = (u.s.high << b) | (u.s.low >> (32 - b));
+        u.s.low = u.s.low << b;
+    }
+    return u.sll;
+}
+
+i64 __ashrdi3(i64 a, int b)
+{
+    DW u;
+    u.sll = a;
+    if (b >= 32) {
+        u.s.low = (u32)((int)u.s.high >> (b - 32));
+        u.s.high = (u32)((int)u.s.high >> 31);   /* 符号で埋める */
+    } else if (b != 0) {
+        u.s.low = (u.s.low >> b) | (u.s.high << (32 - b));
+        u.s.high = (u32)((int)u.s.high >> b);
+    }
+    return u.sll;
+}
+
+u64 __lshrdi3(u64 a, int b)
+{
+    DW u;
+    u.ll = a;
+    if (b >= 32) {
+        u.s.low = u.s.high >> (b - 32);
+        u.s.high = 0;
+    } else if (b != 0) {
+        u.s.low = (u.s.low >> b) | (u.s.high << (32 - b));
+        u.s.high = u.s.high >> b;
+    }
+    return u.ll;
+}
+
+/* 符号つき 64 bit から浮動小数点へ。
+ *
+ * **libtcc1.c の __floatundidf を呼んではいけない。** あちらは
+ * `(double)uu.ll` (uu.ll は符号つき) と書いており，それがこちらへ
+ * 戻ってくる。互いに呼び合って戻らなくなる。
+ *
+ * 上下の語に分けて 32 bit の変換命令 (fcvt.d.w / fcvt.d.wu) で作る。
+ * 32 bit の整数は double にそのまま収まり，2^32 倍も指数を動かすだけ
+ * なので誤差が出ない。丸めが起きるのは最後の足し算 1 回だけである。 */
+
+double __floatdidf(i64 a)
+{
+    DW u;
+    u.sll = a;
+    return (double)(int)u.s.high * 4294967296.0 + (double)u.s.low;
+}
+
+/* float は double を経由する。**丸めが 2 回起きる**ので，
+ * 最後の 1 bit が libgcc と食い違うことがありうる。tcc の自己ホストに
+ * float の 64 bit 変換は出てこないので，ここは簡単な方を採る。 */
+float __floatdisf(i64 a)
+{
+    return (float)__floatdidf(a);
+}
