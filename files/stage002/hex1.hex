# stage002/hex1 のソース (hex0 言語，docs/stage002-hex1.md)。
# hex0 でビルドする: sh tools/env.sh qemu stage001/hex0.bin < 本ファイル > hex1.bin
#
# ブロック配置 (先頭 = 0x8000_0000。ブロック間は 00 パディング):
#   +0x000 init+pass0   入力全体を RAM バッファへ読み込む
#   +0x100 scanner      走査本体 (pass1: アドレス計算 / pass2: 出力)
#   +0x200 h_colon      ':' ラベル定義
#   +0x280 h_amp        '&' 絶対アドレス出力
#   +0x300 h_bang       '!' B-type 参照合成
#   +0x400 h_dollar     '$' J-type 参照合成
#   +0x500 parse_name   名前の読取り (scratch へ格納)
#   +0x600 lookup       シンボル表の線形探索
#   +0x680 hexval       16 進数字の値化 (非 16 進はエラー 1)
#   +0x700 read_byte    バッファからの hex ペア読取り (template 用)
#   +0x780 emit_byte    1 バイト出力 (pass2 のみ UART へ)
#   +0x7c0 emit_word    32bit 語を LE で 4 バイト出力
#   +0x800 exit/err     終了コード設定と test finisher 書込み
#
# レジスタ割当:
#   x1  link (parse_name/lookup/emit_word 呼出し)   x16 シンボル表 次エントリ
#   x5  UART base 0x1000_0000                        x17 lookup 結果 (0=未発見)
#   x6  finisher 0x0010_0000                         x18 scratch base 0x800f_0000
#   x7  現在の文字                                   x19 シンボル表 base 0x8010_0000
#   x8  バイト値                                     x20 入力バッファ base 0x8020_0000
#   x9  桁状態                                       x21 テンプレート語 / 合成結果
#   x10-x12 一時値                                   x22 相対オフセット
#   x13 バッファポインタ                             x23 一時値
#   x14 出力アドレス (絶対)                          x28 link (emit_byte/read_byte)
#   x15 パス番号 (1/2)                               x29 link (hexval)
#
# シンボル表エントリ: 20 バイト = 長さ 1 + 名前 15 (0 詰め) + アドレス 4

# ---- +0x000: init + pass0 (UART -> バッファ。コメント内の '.' は終端としない) ----
b7 02 00 10   # 000: lui  x5, 0x10000      ; UART base
37 03 10 00   # 004: lui  x6, 0x100        ; finisher base
37 09 0f 80   # 008: lui  x18, 0x800f0     ; scratch base
b7 09 10 80   # 00c: lui  x19, 0x80100     ; シンボル表 base
33 88 09 00   # 010: add  x16, x19, x0     ; 次エントリ = base
37 0a 20 80   # 014: lui  x20, 0x80200     ; 入力バッファ base
b3 06 0a 00   # 018: add  x13, x20, x0     ; 書込みポインタ
13 06 00 00   # 01c: addi x12, x0, 0       ; コメント内フラグ = 0
03 c5 52 00   # 020: lbu  x10, 5(x5)       ; p0_loop: LSR
13 75 15 00   # 024: andi x10, x10, 1      ; DR
e3 0c 05 fe   # 028: beq  x10, x0, 020     ; 受信待ち
83 c3 02 00   # 02c: lbu  x7, 0(x5)        ; RBR
23 80 76 00   # 030: sb   x7, 0(x13)       ; バッファへ格納
93 86 16 00   # 034: addi x13, x13, 1
63 1c 06 00   # 038: bne  x12, x0, 050     ; コメント内 -> p0_incom
13 05 30 02   # 03c: addi x10, x0, 0x23    ; '#'
63 82 a3 02   # 040: beq  x7, x10, 064     ; -> p0_setcom
13 05 e0 02   # 044: addi x10, x0, 0x2e    ; '.'
63 84 a3 02   # 048: beq  x7, x10, 070     ; -> p0_done
6f f0 5f fd   # 04c: jal  x0, 020          ; p0_loop
13 05 a0 00   # 050: addi x10, x0, 0x0a    ; p0_incom: LF
63 84 a3 00   # 054: beq  x7, x10, 05c     ; -> p0_clrcom
6f f0 9f fc   # 058: jal  x0, 020          ; p0_loop
13 06 00 00   # 05c: addi x12, x0, 0       ; p0_clrcom
6f f0 1f fc   # 060: jal  x0, 020          ; p0_loop
13 06 10 00   # 064: addi x12, x0, 1       ; p0_setcom
6f f0 9f fb   # 068: jal  x0, 020          ; p0_loop
00 00 00 00   # 06c: (未使用)
93 07 10 00   # 070: addi x15, x0, 1       ; p0_done: pass = 1
6f 00 c0 08   # 074: jal  x0, 100          ; scan_init へ

# ---- +0x078..0x0ff: パディング ----
00 00 00 00  00 00 00 00   # 078
00 00 00 00  00 00 00 00   # 080
00 00 00 00  00 00 00 00   # 088
00 00 00 00  00 00 00 00   # 090
00 00 00 00  00 00 00 00   # 098
00 00 00 00  00 00 00 00   # 0a0
00 00 00 00  00 00 00 00   # 0a8
00 00 00 00  00 00 00 00   # 0b0
00 00 00 00  00 00 00 00   # 0b8
00 00 00 00  00 00 00 00   # 0c0
00 00 00 00  00 00 00 00   # 0c8
00 00 00 00  00 00 00 00   # 0d0
00 00 00 00  00 00 00 00   # 0d8
00 00 00 00  00 00 00 00   # 0e0
00 00 00 00  00 00 00 00   # 0e8
00 00 00 00  00 00 00 00   # 0f0
00 00 00 00  00 00 00 00   # 0f8

# ---- +0x100: scanner (pass1/pass2 共用の走査本体) ----
b3 06 0a 00   # 100: add  x13, x20, x0     ; scan_init: 読取りポインタ = バッファ先頭
37 07 00 80   # 104: lui  x14, 0x80000     ; 出力アドレス = 0x8000_0000
93 04 00 00   # 108: addi x9, x0, 0        ; 桁状態 = 上位桁待ち
83 c3 06 00   # 10c: lbu  x7, 0(x13)       ; scan_loop: 1 文字取得
93 86 16 00   # 110: addi x13, x13, 1
13 05 00 03   # 114: addi x10, x0, 0x30    ; '0'
63 c6 a3 04   # 118: blt  x7, x10, 164     ; -> s_nothex
13 05 a0 03   # 11c: addi x10, x0, 0x3a    ; '9'+1
63 cc a3 00   # 120: blt  x7, x10, 138     ; -> s_dig09
13 05 10 06   # 124: addi x10, x0, 0x61    ; 'a'
63 ce a3 02   # 128: blt  x7, x10, 164     ; -> s_nothex
13 05 70 06   # 12c: addi x10, x0, 0x67    ; 'f'+1
63 c8 a3 00   # 130: blt  x7, x10, 140     ; -> s_digaf
6f 00 00 03   # 134: jal  x0, 164          ; s_nothex
93 85 03 fd   # 138: addi x11, x7, -0x30   ; s_dig09
6f 00 80 00   # 13c: jal  x0, 144          ; s_have
93 85 93 fa   # 140: addi x11, x7, -0x57   ; s_digaf
63 98 04 00   # 144: bne  x9, x0, 154      ; s_have: 下位桁待ち -> s_low
13 94 45 00   # 148: slli x8, x11, 4       ; 上位桁
93 04 10 00   # 14c: addi x9, x0, 1
6f f0 df fb   # 150: jal  x0, 10c          ; scan_loop
33 64 b4 00   # 154: or   x8, x8, x11      ; s_low: バイト完成
6f 0e 80 62   # 158: jal  x28, 780         ; emit_byte
93 04 00 00   # 15c: addi x9, x0, 0
6f f0 df fa   # 160: jal  x0, 10c          ; scan_loop
63 9c 04 04   # 164: bne  x9, x0, 1bc      ; s_nothex: 桁間 -> s_nh_low
13 05 30 02   # 168: addi x10, x0, 0x23    ; '#'
63 8e a3 04   # 16c: beq  x7, x10, 1c8     ; -> s_comment
13 05 00 02   # 170: addi x10, x0, 0x20    ; SP
e3 8c a3 f8   # 174: beq  x7, x10, 10c
13 05 90 00   # 178: addi x10, x0, 0x09    ; TAB
e3 88 a3 f8   # 17c: beq  x7, x10, 10c
13 05 d0 00   # 180: addi x10, x0, 0x0d    ; CR
e3 84 a3 f8   # 184: beq  x7, x10, 10c
13 05 a0 00   # 188: addi x10, x0, 0x0a    ; LF
e3 80 a3 f8   # 18c: beq  x7, x10, 10c
13 05 e0 02   # 190: addi x10, x0, 0x2e    ; '.'
63 84 a3 04   # 194: beq  x7, x10, 1dc     ; -> s_end
13 05 a0 03   # 198: addi x10, x0, 0x3a    ; ':'
63 82 a3 06   # 19c: beq  x7, x10, 200     ; -> h_colon
13 05 10 02   # 1a0: addi x10, x0, 0x21    ; '!'
63 8e a3 14   # 1a4: beq  x7, x10, 300     ; -> h_bang
13 05 40 02   # 1a8: addi x10, x0, 0x24    ; '$'
63 8a a3 24   # 1ac: beq  x7, x10, 400     ; -> h_dollar
13 05 60 02   # 1b0: addi x10, x0, 0x26    ; '&'
63 86 a3 0c   # 1b4: beq  x7, x10, 280     ; -> h_amp
6f 00 80 64   # 1b8: jal  x0, 800          ; err1
13 05 e0 02   # 1bc: addi x10, x0, 0x2e    ; s_nh_low: '.'
63 86 a3 64   # 1c0: beq  x7, x10, 80c     ; -> err2
6f 00 c0 63   # 1c4: jal  x0, 800          ; err1
83 c3 06 00   # 1c8: lbu  x7, 0(x13)       ; s_comment
93 86 16 00   # 1cc: addi x13, x13, 1
13 05 a0 00   # 1d0: addi x10, x0, 0x0a    ; LF
e3 8c a3 f2   # 1d4: beq  x7, x10, 10c     ; scan_loop
6f f0 1f ff   # 1d8: jal  x0, 1c8          ; s_comment
13 05 20 00   # 1dc: addi x10, x0, 2       ; s_end
63 80 a7 66   # 1e0: beq  x15, x10, 840    ; pass2 完了 -> exit_pass
93 07 20 00   # 1e4: addi x15, x0, 2       ; pass = 2
6f f0 9f f1   # 1e8: jal  x0, 100          ; scan_init

# ---- +0x1ec..0x1ff: パディング ----
00 00 00 00   # 1ec
00 00 00 00  00 00 00 00   # 1f0
00 00 00 00  00 00 00 00   # 1f8

# ---- +0x200: h_colon (':' ラベル定義。pass1 のみ登録，pass2 は読み飛ばし) ----
ef 00 00 30   # 200: jal  x1, 500           ; parse_name
13 05 20 00   # 204: addi x10, x0, 2
e3 82 a7 f0   # 208: beq  x15, x10, 10c     ; pass2 -> scan_loop (登録済み)
ef 00 40 3f   # 20c: jal  x1, 600           ; lookup
63 9a 08 60   # 210: bne  x17, x0, 824      ; 発見 -> err4 (重複定義)
03 25 09 00   # 214: lw   x10, 0(x18)       ; scratch 4 語をエントリへ複写
23 20 a8 00   # 218: sw   x10, 0(x16)
03 25 49 00   # 21c: lw   x10, 4(x18)
23 22 a8 00   # 220: sw   x10, 4(x16)
03 25 89 00   # 224: lw   x10, 8(x18)
23 24 a8 00   # 228: sw   x10, 8(x16)
