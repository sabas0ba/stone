# Stage 19 の最初の対象とする Linux 5.4 の設定 (docs/stage019-linux.md 5 章)
#
#   make ARCH=riscv KCONFIG_ALLCONFIG=stage019/rv32-stone.config allnoconfig
#
# allnoconfig を土台に，ここに書いた記号だけに値を与える。kernel/configs/tiny.config
# の中身に，RV32 と QEMU virt で起動して initramfs の init を走らせるのに要る
# ものを足した。
#
#   RV32I        stone のチェーンは RV32IM を生成する。浮動小数点 (FPU) と
#                圧縮命令 (C) は使わない
#   SMP          1 hart で起動する
#   HVC_RISCV_SBI / SERIAL_EARLYCON_RISCV_SBI
#                console は SBI の putchar を通す。SBI は我々が M モードで書く
#   BLK_DEV_INITRD / BINFMT_ELF
#                initramfs に置いた ELF の init を走らせる

# kernel/configs/tiny.config
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_BZIP2 is not set
# CONFIG_KERNEL_LZMA is not set
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
CONFIG_OPTIMIZE_INLINING=y
# CONFIG_SLAB is not set
# CONFIG_SLUB is not set
CONFIG_SLOB=y

# RV32 と起動に要るもの
CONFIG_ARCH_RV32I=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
