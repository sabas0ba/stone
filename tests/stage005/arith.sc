// 仕様 2.5 節: 演算子の優先順位・短絡評価・比較・シフト。
// 各検査が成功なら 'o' を出力する。全 16 検査 + 改行。
int ok;
int chk(int cond) {
  if (cond) putc(111);
  else { putc(88); ok = 1; }
  return 0;
}
int main() {
  ok = 0;
  chk(2 + 3 * 4 == 14);
  chk((2 + 3) * 4 == 20);
  chk(10 - 3 - 2 == 5);
  chk(7 / 2 == 3);
  chk(7 % 2 == 1);
  chk(-5 + 8 == 3);
  chk(1 << 4 == 16);
  chk((255 >> 4) == 15);
  chk((5 & 3) == 1);
  chk((5 | 3) == 7);
  chk((5 ^ 3) == 6);
  chk(3 < 7 && 7 <= 7);
  chk(0 || !0);
  chk(1 && 2);
  chk((3 > 7) == 0);
  chk(5 >= 6 || 6 >= 6);
  putc(10);
  return ok;
}
