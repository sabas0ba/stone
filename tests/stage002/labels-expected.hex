# labels.hex1 の期待バイナリ (hex0 言語，オフセット手計算版)。
# hex0(本ファイル) と hex1(labels.hex1) の出力が一致することを検証する。

b7 02 00 10   # 00: lui  x5, 0x10000
13 04 10 04   # 04: addi x8, x0, 0x41
93 04 60 04   # 08: addi x9, x0, 0x46
23 80 82 00   # 0c: sb   x8, 0(x5)
13 04 14 00   # 10: addi x8, x8, 1
e3 4c 94 fe   # 14: blt  x8, x9, -8      ; loop (0x0c)
6f 00 c0 00   # 18: jal  x0, +12         ; end (0x24)
20 00 00 80   # 1c: 0x80000020 (msg の絶対アドレス, LE)
de ad be ef   # 20: データ
37 56 00 00   # 24: lui  x12, 0x5
13 06 56 55   # 28: addi x12, x12, 0x555
37 03 10 00   # 2c: lui  x6, 0x100
23 20 c3 00   # 30: sw   x12, 0(x6)
6f 00 00 00   # 34: jal  x0, 0
.
